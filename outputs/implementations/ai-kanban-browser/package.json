{
  "name": "ai-kanban-browser",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "serve": "node scripts/serve-static.mjs",
    "verify:vendor": "node scripts/verify-vendor-assets.mjs",
    "test": "npm run test:unit && npm run verify:vendor",
    "test:unit": "node --test tests/*.test.mjs",
    "test:ui": "playwright test",
    "test:python": "python -m pytest tests/python -q"
  },
  "dependencies": {
    "sql.js": "1.14.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1"
  }
}
